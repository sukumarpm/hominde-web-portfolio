# ---------------------------------------------------------------------
# Hominode Environment Variables — EXAMPLE FILE
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ---------------------------------------------------------------------

# -- Email destination ------------------------------------------------
# The Hominode business email that receives all inquiries.
CONTACT_EMAIL=hello@hominode.com

# -- Email sender details ---------------------------------------------
# The "From" name and address shown in received emails.
# Must be a verified sender domain in your email provider.
EMAIL_FROM_NAME=Hominode
EMAIL_FROM_ADDRESS=noreply@hominode.com

# -- Email provider ---------------------------------------------------
# Options: resend | sendgrid
# Defaults to "resend" if not set.
EMAIL_PROVIDER=resend

# -- Resend API Key ---------------------------------------------------
# Get your key at: https://resend.com/api-keys
# Free tier: 3,000 emails/month, 100/day
RESEND_API_KEY=re_your_resend_api_key_here

# -- SendGrid API Key (alternative) -----------------------------------
# Get your key at: https://app.sendgrid.com/settings/api_keys
# Set EMAIL_PROVIDER=sendgrid to use this instead of Resend.
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# -- SMTP (optional — for self-hosted email) ---------------------------
# Only needed if you implement an SMTP nodemailer adapter.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@hominode.com
SMTP_PASS=your_smtp_password_here

# ---------------------------------------------------------------------
# IMPORTANT: Never put real API keys or passwords in this file.
# This file is safe to commit. Copy it to .env and add real values.
# ---------------------------------------------------------------------
